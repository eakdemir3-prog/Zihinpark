### OYUN 14: REFLEKS ARENASI
**Kategori:** Refleks | **Mekanik:** Milisaniye Hassasiyetli Sistem Saati Ölçümü.

```kotlin
class ReflexArenaViewModel : ViewModel() {
    private var startTimeMs: Long = 0L

    private val _state = MutableStateFlow<ReflexState>(ReflexState.Waiting)
    val state = _state.asStateFlow()

    fun startTest() {
        _state.value = ReflexState.Ready
        val delayMs = (2000..5000).random().toLong()
        viewModelScope.launch {
            delay(delayMs)
            if (_state.value == ReflexState.Ready) {
                startTimeMs = System.currentTimeMillis()
                _state.value = ReflexState.Triggered
            }
        }
    }

    fun onScreenTapped() {
        when (_state.value) {
            is ReflexState.Ready -> {
                _state.value = ReflexState.EarlyTap // Erken dokunma cezası
            }
            is ReflexState.Triggered -> {
                val reactionTime = System.currentTimeMillis() - startTimeMs
                _state.value = ReflexState.Success(reactionTime)
            }
            else -> {}
        }
    }
}

sealed class ReflexState {
    object Waiting : ReflexState()
    object Ready : ReflexState()
    object Triggered : ReflexState()
    object EarlyTap : ReflexState()
    data class Success(val timeMs: Long) : ReflexState()
}
