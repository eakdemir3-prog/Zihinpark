class CipherViewModel : ViewModel() {
    private val _uiState = MutableStateFlow(CipherState())
    val uiState: StateFlow<CipherState> = _uiState.asStateFlow()

    private val alphabet = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ"

    init { startNewLevel() }

    fun startNewLevel() {
        val originalWord = "BİLGİSAYAR"
