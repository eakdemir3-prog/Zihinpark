### OYUN 5: İMKÂNSIZ GÖREVLER
**Kategori:** Problem Çözme | **Mekanik:** Kurt, Koyun, Ot Nehirden Geçiş Mantığı.

```kotlin
enum class Bank { LEFT, RIGHT }
data class RiverItem(val name: String, var location: Bank)

class RiverCrossingViewModel : ViewModel() {
    private val _items = MutableStateFlow(
        listOf(
            RiverItem("Kurt", Bank.LEFT),
            RiverItem("Koyun", Bank.LEFT),
            RiverItem("Ot", Bank.LEFT)
        )
    )
    val items: StateFlow<List<RiverItem>> = _items.asStateFlow()

    private val _boatPosition = MutableStateFlow(Bank.LEFT)
    val boatPosition: StateFlow<Bank> = _boatPosition.asStateFlow()

    private val _moveCount = MutableStateFlow(0)
    val moveCount: StateFlow<Int> = _moveCount.asStateFlow()

    private val _gameState = MutableStateFlow("Oynanıyor...")
    val gameState: StateFlow<String> = _gameState.asStateFlow()

    fun moveItem(item: RiverItem) {
        if (item.location != _boatPosition.value) return // Sadece kayığın olduğu kıyıdaki eşya taşınabilir.

        val updated = _items.value.map {
            if (it.name == item.name) it.copy(location = toggleBank(it.location)) else it
        }
        _items.value = updated
        _boatPosition.value = toggleBank(_boatPosition.value)
        _moveCount.value += 1

        evaluateRules()
    }

    fun moveBoatEmpty() {
        _boatPosition.value = toggleBank(_boatPosition.value)
        _moveCount.value += 1
        evaluateRules()
    }

    private fun toggleBank(bank: Bank) = if (bank == Bank.LEFT) Bank.RIGHT else Bank.LEFT

    private fun evaluateRules() {
        val boat = _boatPosition.value
        val wolf = _items.value.find { it.name == "Kurt" }!.location
        val sheep = _items.value.find { it.name == "Koyun" }!.location
        val cabbage = _items.value.find { it.name == "Ot" }!.location

        // Kurt ile Koyun yalnız kalırsa
        if (wolf == sheep && wolf != boat) {
            _gameState.value = "BAŞARISIZ! Kurt koyunu yedi."
            return
        }
        // Koyun ile Ot yalnız kalırsa
        if (sheep == cabbage && sheep != boat) {
            _gameState.value = "BAŞARISIZ! Koyun otu yedi."
            return
        }
        // Tümü sağ kıyıda ise
        if (_items.value.all { it.location == Bank.RIGHT }) {
            _gameState.value = "TEBRİKLER! Görevi tamamladınız."
        }
    }
}
