```kotlin
class MemoryLightsViewModel : ViewModel() {
    private val _sequence = MutableStateFlow<List<Int>>(emptyList())
    val sequence = _sequence.asStateFlow()

    private val _userStep = MutableStateFlow(0)
    private val _isUserTurn = MutableStateFlow(false)
    val isUserTurn = _isUserTurn.asStateFlow()

    fun startNextRound() {
        val nextColorIndex = (0..3).random()
        _sequence.value = _sequence.value + nextColorIndex
        _userStep.value = 0
        playSequence()
    }

    private fun playSequence() {
        viewModelScope.launch {
            _isUserTurn.value = false
            for (color in _sequence.value) {
                delay(600) // Işık yanma süresi
            }
            _isUserTurn.value = true
        }
    }

    fun onPadTapped(index: Int) {
        if (!_isUserTurn.value) return

        if (_sequence.value[_userStep.value] == index) {
            _userStep.value += 1
            if (_userStep.value == _sequence.value.size) {
                // Tur Başarılı
                startNextRound()
            }
        } else {
            // Hata / Oyun Bitti
        }
    }
}
