data class TangramPiece(
    val id: Int,
    val currentX: Float,
    val currentY: Float,
    val targetX: Float,
    val targetY: Float,
    val rotation: Float,
    val targetRotation: Float
)

class ShapeArchitectViewModel : ViewModel() {
    private val _pieces = MutableStateFlow(
        listOf(
            TangramPiece(1, 50f, 50f, 200f, 200f, 0f, 90f),
            TangramPiece(2, 100f, 300f, 350f, 200f, 45f, 0f)
        )
    )
    val pieces: StateFlow<List<TangramPiece>> = _pieces.asStateFlow()

    fun updatePiecePosition(id: Int, x: Float, y: Float) {
        _pieces.value = _pieces.value.map {
            if (it.id == id) it.copy(currentX = x, currentY = y) else it
        }
        checkSnapConditions()
    }

    fun rotatePiece(id: Int) {
        _pieces.value = _pieces.value.map {
            if (it.id == id) it.copy(rotation = (it.rotation + 45f) % 360f) else it
        }
        checkSnapConditions()
    }

    private fun checkSnapConditions() {
        val tolerance = 30f
        val isAssemblyComplete = _pieces.value.all { piece ->
            Math.abs(piece.currentX - piece.targetX) < tolerance &&
            Math.abs(piece.currentY - piece.targetY) < tolerance &&
            Math.abs(piece.rotation - piece.targetRotation) < 5f
        }
        if (isAssemblyComplete) {
            // Seviye tamamlandı
        }
    }
}
