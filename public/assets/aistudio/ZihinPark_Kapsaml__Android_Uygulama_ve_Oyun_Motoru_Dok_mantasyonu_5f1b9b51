### OYUN 3: GİZLİ RESİM (NONOGRAM)
**Kategori:** Görsel Mantık | **Mekanik:** Grid hücre durum kontrolü (EMPTY, FILLED, CROSS).

```kotlin
enum class CellState { EMPTY, FILLED, CROSS }

class NonogramViewModel : ViewModel() {
    private val boardSize = 5
    // Gizli Kalp Deseni
    private val solution = arrayOf(
        booleanArrayOf(false, true, false, true, false),
        booleanArrayOf(true, true, true, true, true),
        booleanArrayOf(true, true, true, true, true),
        booleanArrayOf(false, true, true, true, false),
        booleanArrayOf(false, false, true, false, false)
    )

    private val _userGrid = MutableStateFlow(Array(boardSize) { Array(boardSize) { CellState.EMPTY } })
    val userGrid: StateFlow<Array<Array<CellState>>> = _userGrid.asStateFlow()

    val rowClues: List<List<Int>> = solution.map { calculateLineClues(it) }
    val colClues: List<List<Int>> = (0 until boardSize).map { col ->
        calculateLineClues(BooleanArray(boardSize) { row -> solution[row][col] })
    }

    fun toggleCell(r: Int, c: Int) {
        val current = _userGrid.value
        val newGrid = current.map { it.clone() }.toTypedArray()
        newGrid[r][c] = when (newGrid[r][c]) {
            CellState.EMPTY -> CellState.FILLED
            CellState.FILLED -> CellState.CROSS
            CellState.CROSS -> CellState.EMPTY
        }
        _userGrid.value = newGrid
        checkSolution()
    }

    private fun calculateLineClues(line: BooleanArray): List<Int> {
        val clues = mutableListOf<Int>()
        var count = 0
        for (b in line) {
            if (b) count++
            else if (count > 0) { clues.add(count); count = 0 }
        }
        if (count > 0) clues.add(count)
        return if (clues.isEmpty()) listOf(0) else clues
    }

    fun checkSolution(): Boolean {
        for (r in 0 until boardSize) {
            for (c in 0 until boardSize) {
                val isFilled = _userGrid.value[r][c] == CellState.FILLED
                if (isFilled != solution[r][c]) return false
            }
        }
        return true
    }
}
```

