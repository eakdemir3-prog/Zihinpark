### OYUN 2: ZİHİN DÖNDÜRME
**Kategori:** Uzamsal Zekâ | **Mekanik:** 2D Vektör matris döndürme mantığı.

```kotlin
data class ShapeMatrix(val grid: Array<BooleanArray>, val rotationDegrees: Int)

class SpatialRotationViewModel : ViewModel() {
    private val _uiState = MutableStateFlow(SpatialState())
    val uiState: StateFlow<SpatialState> = _uiState.asStateFlow()

    init { generateQuestion() }

    fun generateQuestion() {
        val originalGrid = arrayOf(
            booleanArrayOf(true, true, false),
            booleanArrayOf(false, true, false),
            booleanArrayOf(false, true, true)
        )
        val rotated90 = rotate90Degrees(originalGrid)
        val rotated180 = rotate90Degrees(rotated90)
        val rotated270 = rotate90Degrees(rotated180)

        val options = listOf(rotated90, rotated180, rotated270).shuffled()
        val targetDegree = 90
        val correctIndex = options.indexOfFirst { areGridsEqual(it, rotated90) }

        _uiState.value = SpatialState(
            originalShape = originalGrid,
            targetDegree = targetDegree,
            options = options,
            correctAnswerIndex = correctIndex
        )
    }

    private fun rotate90Degrees(grid: Array<BooleanArray>): Array<BooleanArray> {
        val size = grid.size
        val result = Array(size) { BooleanArray(size) }
        for (i in 0 until size) {
            for (j in 0 until size) {
                result[j][size - 1 - i] = grid[i][j]
            }
        }
        return result
    }

    private fun areGridsEqual(a: Array<BooleanArray>, b: Array<BooleanArray>): Boolean {
        return a.contentDeepEquals(b)
    }

    fun submitAnswer(selectedIndex: Int) {
        val isCorrect = selectedIndex == _uiState.value.correctAnswerIndex
        _uiState.value = _uiState.value.copy(
            isAnswered = true,
            isCorrect = isCorrect,
            score = if (isCorrect) _uiState.value.score + 50 else _uiState.value.score
        )
    }
}

data class SpatialState(
    val originalShape: Array<BooleanArray> = arrayOf(),
    val targetDegree: Int = 0,
    val options: List<Array<BooleanArray>> = emptyList(),
    val correctAnswerIndex: Int = -1,
    val isAnswered: Boolean = false,
    val isCorrect: Boolean = false,
    val score: Int = 0
)
