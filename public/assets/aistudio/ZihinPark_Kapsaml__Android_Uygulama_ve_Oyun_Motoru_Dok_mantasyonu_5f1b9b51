### OYUN 10: YOLUN SONU
**Kategori:** Strateji & Planlama | **Mekanik:** Labirent Yol Arama Algoritması (A* / Grid Navigation).

```kotlin
enum class TileType { EMPTY, WALL, KEY, DOOR, DESTINATION }

class PathFinderViewModel : ViewModel() {
    private val mapSize = 6
    private val _gridState = MutableStateFlow(Array(mapSize) { Array(mapSize) { TileType.EMPTY } })
    val gridState = _gridState.asStateFlow()

    private val _playerPos = MutableStateFlow(Pair(0, 0))
    val playerPos = _playerPos.asStateFlow()

    private val _hasKey = MutableStateFlow(false)

    init {
        val grid = _gridState.value
        grid[1][1] = TileType.WALL
        grid[2][2] = TileType.KEY
        grid[4][4] = TileType.DOOR
        grid[5][5] = TileType.DESTINATION
    }

    fun movePlayer(dr: Int, dc: Int) {
        val newR = _playerPos.value.first + dr
        val newC = _playerPos.value.second + dc

        if (newR in 0 until mapSize && newC in 0 until mapSize) {
            val tile = _gridState.value[newR][newC]
            if (tile == TileType.WALL) return
            if (tile == TileType.DOOR && !_hasKey.value) return

            if (tile == TileType.KEY) {
                _hasKey.value = true
                _gridState.value[newR][newC] = TileType.EMPTY
            }

            _playerPos.value = Pair(newR, newC)
        }
    }
}
```

