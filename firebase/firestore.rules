rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı yedeği: herkes yalnızca kendi belgesini okuyup yazabilir
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Haftalık ödül kaydı: bir kez oluşturulur, sonra değiştirilemez
      match /claims/{weekId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diamonds is int
          && request.resource.data.diamonds <= 500;
        allow update, delete: if false;
      }
    }

    // Haftalık lig: herkes okuyabilir, herkes yalnızca kendi satırını yazar
    match /leagues/{weekId}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('score', 0) is int
        && request.resource.data.get('score', 0) <= 1500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
      // Puan yalnızca artabilir ve tek seferde en fazla 1500 artar
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.get('score', 0) >= resource.data.get('score', 0)
        && request.resource.data.get('score', 0) - resource.data.get('score', 0) <= 1500;
      allow delete: if false;
    }
  }
}
